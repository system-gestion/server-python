# Configuración de la base de datos PostgreSQL
DATABASE_URL=postgresql://usuario:password@localhost:5432/nombre_bd

# Configuración del servidor
DEBUG=True
PORT=8000

# Configuración adicional
SECRET_KEY=tu_clave_secreta_aqui

# ============================================
# CONFIGURACIÓN DE EMAIL (Gmail gratuito)
# ============================================
# Para obtener tu App Password de Gmail:
# 1. Ve a: https://myaccount.google.com/security
# 2. Activa "Verificación en 2 pasos" (si no está activada)
# 3. Ve a "Contraseñas de aplicaciones": https://myaccount.google.com/apppasswords
# 4. Selecciona "Correo" y "Otro (nombre personalizado)"
# 5. Ingresa un nombre (ej: "Sistema Gestión") y copia la contraseña generada
# 6. Pégala en GMAIL_PASSWORD (sin espacios)

GMAIL_EMAIL=tu_email@gmail.com
GMAIL_PASSWORD=xxxxxxxxxxxxxxxx
FRONTEND_URL=http://localhost:4200

# NOTAS IMPORTANTES:
# - NO uses tu contraseña normal de Gmail, SOLO usa App Password
# - El App Password tiene 16 caracteres sin espacios
# - Si no configuras Gmail, los emails se mostrarán en consola solamente
# - Gmail gratuito: límite de 500 emails/día (más que suficiente)
